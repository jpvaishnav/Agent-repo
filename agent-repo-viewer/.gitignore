## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
dist/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Local environment files
appsettings.local.json
.env
.env.local

# NuGet
*.nupkg
*.snupkg

# IDE
.idea/
.fleet/

# macOS
.DS_Store

# Linux
.swp
.swo
*~

# Dependencies
node_modules/
package-lock.json
yarn.lock
